nextflow_process {

    name "Test Process VCF_EXTRACTCALLERMETA"
    script "../main.nf"
    process "VCF_EXTRACTCALLERMETA"

    tag "modules"
    tag "modules_nfcore"
    tag "vcf"
    tag "vcf/extractcallermeta"

    test("mutect2 - vcf") {

        when {
            process {
                """
                input[0] = [
                    [id:"mutect2_test"],
                    file("test_data/mutect2_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("deepvariant - vcf") {

        when {
            process {
                """
                input[0] = [
                    [id:"deepvariant_test"],
                    file("test_data/deepvariant_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("dragen - vcf") {

        when {
            process {
                """
                input[0] = [
                    [id:"dragen_test"],
                    file("test_data/dragen_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("mutect2 - vcf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id:"mutect2_test"],
                    file("test_data/mutect2_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}