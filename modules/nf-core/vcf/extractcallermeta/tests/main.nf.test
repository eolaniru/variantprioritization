nextflow_process {

    name "Test Process VCF_EXTRACTCALLERMETA"
    script "../main.nf"
    process "VCF_EXTRACTCALLERMETA"

    tag "modules"
    tag "modules_nfcore"
    tag "vcf"
    tag "vcf/extractcallermeta"

    test("mutect2 - vcf") {

        when {
            process {
                """
                input[0] = [
                    [id:"mutect2_test"],
                    file("test_data/mutect2_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv },
                { assert process.out.versions },
                { assert path(process.out.tsv[0][1]).readLines().size() >= 4 }
            )
        }
    }

    test("mutect2 - vcf - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [id:"mutect2_test"],
                    file("test_data/mutect2_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tsv },
                { assert process.out.versions }
            )
        }
    }
}