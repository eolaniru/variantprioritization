nextflow_process {

    name "Test Process VCF_EXTRACTCALLERMETA"
    script "../main.nf"
    process "VCF_EXTRACTCALLERMETA"

    tag "modules"
    tag "modules_nfcore"
    tag "vcf"
    tag "vcf/extractcallermeta"

    test("mutect2 - vcf") {

        when {
            process {
                """
                input[0] = [
                    [id:"mutect2_test"],
                    file("${moduleDir}/tests/test_data/mutect2_test.vcf", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("mutect2_vcf") },
                { 
                    def tsv_content = path(process.out.tsv[0][1]).readLines()
                    assert tsv_content.contains("caller\tMutect2")
                    assert tsv_content.contains("version\t4.2.6.1")
                    assert tsv_content.contains("reference\tfile:///ref/hg38.fa")
                }
            )
        }
    }

    test("mutect2 - vcf.gz") {

        when {
            process {
                """
                input[0] = [
                    [id:"mutect2_test_gz"],
                    file("${moduleDir}/tests/test_data/mutect2_test.vcf.gz", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match("mutect2_vcf_gz") },
                { 
                    def tsv_content = path(process.out.tsv[0][1]).readLines()
                    assert tsv_content.contains("caller\tMutect2")
                    assert tsv_content.contains("version\t4.2.6.1")
                }
            )
        }
    }

